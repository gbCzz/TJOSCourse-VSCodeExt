{
  "name": "tongjios",
  "displayName": "TongjiOS",
  "description": "同济大学本科《操作系统》课程实验平台配套插件",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TongjiOS",
      "properties": {
        "tongjios.platformUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "课程平台的 HTTPS 基址，可含部署路径前缀；不要填写登录页面路径、账号或查询参数。请使用课程提供的实际地址。"
        }
      }
    },
    "commands": [
      {
        "command": "tongjios.showStatus",
        "title": "检查状态",  
        "category": "TJOS"
      },
      {
        "command": "tongjios.login",
        "title": "登录课程平台账号",
        "category": "TJOS"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha --ui tdd out/test/auth.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "mocha": "^11.7.6",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
